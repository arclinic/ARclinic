# SMTP настройки для отправки отчётов (опционально)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=arclinic.adwords@gmail.com
SMTP_PASSWORD=your_gmail_app_password_here

# Отправка отчёта
REPORT_TO=arclinic.adwords@gmail.com

# Apify API ключи (ротация) — список через запятую
APIFY_KEYS=apify_api_key1,apify_api_key2

# VK API (для парсинга групп) — оставь пустым, если не нужно
VK_ACCESS_TOKEN=

# YouTube Data API v3 — оставь пустым, если не нужно
YOUTUBE_API_KEY=

# Настройки парсинга
MAX_POSTS_PER_ACCOUNT=50
OUTLIER_THRESHOLD=2.0

# SQLite БД
DB_PATH=./data/metrics.db
