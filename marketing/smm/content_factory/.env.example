# Apify API (X/Twitter, Instagram, TikTok scraping)
# Get your token: https://console.apify.com/account/integrations
APIFY_TOKEN=your_apify_token_here

# TubeLab API (YouTube outlier detection)
# Get your key: https://tubelab.net/settings/api
TUBELAB_API_KEY=your_tubelab_api_key_here

# Google Gemini API (Video analysis)
# Get your key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# AI Model Configuration (Promptra — OpenAI-совместимый прокси)
# Получить ключ: регистрация на promptra.ru
# Ключ можно хранить в User-переменной Windows:
#   [Environment]::SetEnvironmentVariable('AI_API_KEY', 'твой_ключ', 'User')
AI_MODEL=deepseek/deepseek-v4-pro
AI_API_KEY=your_promptra_api_key_here
AI_API_BASE_URL=https://api.promptra.ru/v1

# Research Settings
MAX_POSTS_PER_ACCOUNT=50
OUTLIER_THRESHOLD=2.0
DAYS_TO_ANALYZE=30
