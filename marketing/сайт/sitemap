<script>
	(function indexParallax() {
        var $paralaxElem = document.querySelector('.section--service_index');
		if($paralaxElem){
        var style = window.getComputedStyle($paralaxElem, null);
        $paralaxElem.startHeight = parseInt(style.getPropertyValue("height"));

        window.addEventListener('scroll', function () {
            var scroll_perc = parseInt(window.pageYOffset);

			function setTranslate(xPos, yPos, elem) {
            	elem.style.transform = "translate3d(" + xPos + "px, " + yPos + "px, 0)";
        	}

            if (scroll_perc < 250 && scroll_perc > 10) {
                setTranslate(0, -window.pageYOffset / 2, $paralaxElem);
            }
		})}
	})();
</script>
