<script>
    function animation() {
        var animate = [];
        var time;
        animate.items = document.querySelectorAll(".animate");

        for (var i = 0; i < animate.items.length; i++) {
            if (animate.items[i].classList.contains("animate--from_count")) {
                function delay() {
                    this.classList.add("animate--to_stock")
                }

                time = i * 150;
                setTimeout(delay.bind(animate.items[i]), time)
            }
            else {
                animate.items[i].classList.add("animate--to_stock");
            }
        }
    }
    document.addEventListener("DOMContentLoaded", function () {
        animation();
    });
</script>

<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/1.19.1/TweenMax.min.js"></script>

<script>
    //animation square items
    var serviceItems = document.querySelectorAll(".service--title_up");
    for (var q = 0; q < serviceItems.length; q++) {
        var serviceItem = serviceItems[q];
        serviceItem.addEventListener("mouseenter", function () {
            titleUp(this, true);
        })
        serviceItem.addEventListener("mouseleave", function () {
            titleUp(this, false);
        })
    }

    function titleUp(service, state) {
        var $title = service.querySelector(".service__title");
        var $img = service.querySelector(".service__img");
        var $text = service.querySelector(".service__text");
        var $overflow = service.querySelector(".service__overflow");

        if (state) {
            TweenLite.to($title, .3, {minHeight: "100%"});
            TweenLite.to($img, .2, {'-webkit-filter': 'blur(10px)'});
            TweenLite.to($text, .3, {delay: 0, ease: Back.easeOut.config(0), bottom: 0, opacity: 1});
            TweenLite.to($overflow, .3, {
                backgroundColor: "rgba(225, 10, 19, .7)",
                backgroundImage: 'url("/local/templates/arclinic/img/main_pattern--5.png")'
            });

        } else {
            TweenLite.to($title, .3, {minHeight: "0"});
            TweenLite.to($img, .2, {'-webkit-filter': 'blur(0px)'});
            TweenLite.to($text, .3, {delay: 0, bottom: "-100%", opacity: 0});
            TweenLite.to($overflow, .3, {
                backgroundColor: "rgba(225, 10, 19, 0)",
                backgroundImage: "linear-gradient(to bottom, rgba(255, 255, 255, 0.0) 4%, rgba(0, 0, 0, 0.3))"
            });
        }
    }
</script>
<script>
    //accordions toggle
    document.querySelectorAll(".accordion__label").forEach(function (elem) {
        elem.addEventListener("click", function () {
            toggleBox(this);
        })
    })

    function toggleBox(box) {
        var boxBody = box.parentNode.querySelector(".accordion__body");
        var boxBtn = box.querySelector(".accordion__btn");
        var boxLabel = box.parentNode.querySelector(".accordion__label");
        var boxItem = box.parentNode;

        if (parseInt(boxBody.style.maxHeight) == 0 || isNaN(parseInt(boxBody.style.maxHeight))) {
            TweenLite.to(boxBody, 0, {maxHeight: boxBody.scrollHeight + 40});
            TweenLite.to(boxBtn, 0, {rotation: "0_short", ease: Back.easeOut.config(1)});
            TweenLite.to(boxLabel, 0, {backgroundColor: "transparent", color: "black"});
            TweenLite.to(boxItem, 0, {boxShadow: "none"});
        }
        else {
            TweenLite.to(boxBody, 0, {clearProps: "all"});
            TweenLite.to(boxBtn, 0, {clearProps: "all"});
            TweenLite.to(boxLabel, 0, {clearProps: "all"});
            TweenLite.to(boxItem, 0, {clearProps: "all"});
        }
    }
</script>


