# Django
DJANGO_SECRET_KEY=django-insecure-change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database
POSTGRES_DB=arclinic
POSTGRES_USER=arclinic
POSTGRES_PASSWORD=arclinic_pass
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Celery
CELERY_BROKER_URL=redis://redis:6379/0

# Sentry (опционально)
SENTRY_DSN=

# File storage
MEDIA_ROOT=/media
STATIC_ROOT=/static
