{
  "$schema": "https://opencode.ai/config.json",
  "username": "ARclinic",
  "skills": {
    "paths": [
      ".opencode/skills",
      "~/.claude/skills"
    ]
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["node", "C:\\Users\\Пользователь\\AppData\\Roaming\\npm\\node_modules\\@playwright\\mcp\\cli.js"],
      "enabled": true
    }
  },
  "permission": {
    "edit": "allow",
    "bash": {
      "rm *": "deny",
      "del *": "deny",
      "Remove-Item *": "deny",
      "*": "ask"
    },
    "external_directory": {
      "**/.env": "deny",
      "**/secrets/**": "deny",
      "**/*.key": "deny",
      "**/*.pem": "deny",
      "**/*.cert": "deny",
      "*": "allow"
    }
  }
}
